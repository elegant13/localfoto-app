{
  "name": "localfoto-app",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "localfoto-db",
      "database_id": "faa39ee4-7b1a-4b44-a48b-03d2c06313ef"
    }
  ]
}
